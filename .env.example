NODE_ENV=development
HOST=127.0.0.1
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gates
DB_USERNAME=gates
DB_PASSWORD=

# Used only by db:seed
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
USDC_SEPOLIA_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_SEPOLIA_DECIMALS=6

WALLET_SERVICE_URL=http://127.0.0.1:8000
WALLET_SERVICE_TOKEN=
WALLET_SERVICE_TIMEOUT=10
# Empty = authorization disabled, matching the Laravel service
GATES_API_KEY=
RPC_TIMEOUT=20
RPC_BATCH_ENABLED=true

# Empty = latest - confirmations_required, on first run only
INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=10
INDEXER_MAX_BLOCKS_PER_RUN=500
INDEXER_KEEP_BLOCKS=256
INDEXER_MAX_REORG_DEPTH=128
HOT_WALLET_ACCOUNT=1
HOT_WALLET_CHANGE=0
HOT_WALLET_INDEX=0
FEE_BASE_FEE_MULTIPLIER=2
FEE_MIN_PRIORITY_FEE_WEI=1000000000
GAS_LIMIT_MULTIPLIER_PERCENT=120
